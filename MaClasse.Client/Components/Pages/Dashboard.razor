@page "/dashboard"
@using MaClasse.Client.Components.DashboardContent.Menu
@using MaClasse.Client.Components.DashboardContent.Calendar
@using Microsoft.AspNetCore.Authorization
@using MaClasse.Client.Components.DashboardContent.Files
@using MaClasse.Client.Components.DashboardContent.Lesson
@using MaClasse.Client.Components.Utils

@attribute [Authorize]

<PageTitle>Tableau de bord</PageTitle>

<a class="dashboard-skip-link" href="#dashboard-main">Aller au contenu principal</a>

<div class="dashboard-page">
    <div class="dashboard-shell">
        <header class="dashboard-topbar">
            <TopMenu/>
        </header>

        <main id="dashboard-main" class="dashboard-content" tabindex="-1">
            <aside class="dashboard-left-panel" aria-label="Panneau ressources">
                <section class="dashboard-card dashboard-hero-card">
                    <p class="dashboard-eyebrow">MaClasse</p>
                    <h2><IllustrationBadge Kind="orbit" />Série pédagogique de la semaine</h2>
                    <p>Préparez vos séances, vos documents et votre suivi élèves depuis un seul espace.</p>
                    <MudButton Variant="MudBlazor.Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.PlayArrow">
                        Commencer
                    </MudButton>
                </section>

                <section class="dashboard-card dashboard-stats-card" aria-label="Indicateurs rapides">
                    <article>
                        <span>Leçons</span>
                        <strong>78</strong>
                    </article>
                    <article>
                        <span>Heures</span>
                        <strong>43</strong>
                    </article>
                </section>

                <section class="dashboard-card dashboard-topics-card" aria-label="Catégories">
                    <MudChip T="string" Color="Color.Success" Variant="MudBlazor.Variant.Outlined">Littérature</MudChip>
                    <MudChip T="string" Color="Color.Warning" Variant="MudBlazor.Variant.Outlined">Maths</MudChip>
                    <MudChip T="string" Color="Color.Info" Variant="MudBlazor.Variant.Outlined">Sciences</MudChip>
                </section>

                <section class="dashboard-card dashboard-files-card" aria-label="Documents">
                    <FileExplorer/>
                </section>
            </aside>

            <section class="dashboard-center-panel" aria-label="Panneau cours">
                <section class="dashboard-card dashboard-center-main-card">
                    <LessonView/>
                </section>
            </section>

            <aside class="dashboard-right-panel" aria-label="Panneau agenda">
                <section class="dashboard-card dashboard-scheduler-card">
                    <Scheduler/>
                </section>

                <section class="dashboard-card dashboard-reading-card" aria-label="Suivi">
                    <h3><IllustrationBadge Kind="book" />Lecture prête aujourd'hui</h3>
                    <p>Rappel des objectifs et créneaux disponibles pour vos classes.</p>
                    <MudButton Variant="MudBlazor.Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Bolt">
                        Voir les priorités
                    </MudButton>
                </section>

                <section class="dashboard-card dashboard-reco-card" aria-label="Recommandations">
                    <h3><IllustrationBadge Kind="star" />Recommandé pour vous</h3>
                    <div>
                        <MudButton Variant="MudBlazor.Variant.Text" Color="Color.Primary">Découvrir sciences</MudButton>
                        <MudButton Variant="MudBlazor.Variant.Text" Color="Color.Secondary">Accueil de rentrée</MudButton>
                    </div>
                </section>
            </aside>
        </main>
    </div>
</div>
