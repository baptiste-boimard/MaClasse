@page "/dashboard"
@using MaClasse.Client.Components.DashboardContent.Menu
@using MaClasse.Client.Components.DashboardContent.Calendar
@using Microsoft.AspNetCore.Authorization
@using MaClasse.Client.Components.DashboardContent.Files
@using MaClasse.Client.Components.DashboardContent.Lesson
@using MaClasse.Client.Components.Utils

@attribute [Authorize]

<PageTitle>Tableau de bord</PageTitle>

<a class="dashboard-skip-link" href="#dashboard-main">Aller au contenu principal</a>

<div class="dashboard-page">
    <div class="dashboard-shell">
        <header class="dashboard-topbar">
            <TopMenu/>
        </header>

        <main id="dashboard-main" class="dashboard-content" tabindex="-1">
            <aside class="dashboard-left-panel" aria-label="Panneau ressources">
                <section class="dashboard-card dashboard-reading-card"
                         aria-label="@(_hasCurrentCourse ? "Cours en cours" : "Prochain cours")"
                         style="@GetNextCourseCardStyle()">
                    <h3>
                        <MudIcon Icon="@Icons.Material.Filled.AutoStories" Class="dashboard-title-icon" aria-hidden="true" />
                        @(_hasCurrentCourse ? "Cours en cours" : "Prochain cours")
                    </h3>
                    <p aria-live="polite">@_nextCoursePreview</p>

                    @if (_nextCourseAppointment is not null)
                    {
                        <h4 class="dashboard-course-title">@(_nextCourseAppointment.Text ?? "Cours sans titre")</h4>
                        <p class="dashboard-course-time">
                            @_nextCourseAppointment.Start.ToLocalTime().ToString("HH:mm")
                            -
                            @_nextCourseAppointment.End.ToLocalTime().ToString("HH:mm")
                        </p>

                        <MudButton Variant="MudBlazor.Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="@OpenNextCourseInLessonPanel">
                            Afficher le cours
                        </MudButton>
                    }
                </section>

                <section class="dashboard-card dashboard-stats-card" aria-label="Indicateurs rapides">
                    <article>
                        <span>Leçons cette semaine</span>
                        <strong>@_weeklyLessonCount</strong>
                    </article>
                    <article>
                        <span>Heures cette semaine</span>
                        <strong>@_weeklyHoursLabel</strong>
                    </article>
                </section>

                <section class="dashboard-card dashboard-files-card" aria-label="Documents">
                    <FileExplorer ShowFileList="false"/>
                </section>
            </aside>

            <section class="dashboard-center-panel" aria-label="Panneau cours">
                <section class="dashboard-card dashboard-center-main-card">
                    <LessonView/>
                </section>
            </section>

            <aside class="dashboard-right-panel" aria-label="Panneau agenda">
                <section class="dashboard-card dashboard-scheduler-card">
                    <Scheduler/>
                </section>

                <ClassToolsPanel/>
            </aside>
        </main>
    </div>
</div>
