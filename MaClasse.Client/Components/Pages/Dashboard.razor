@page "/dashboard"
@using MaClasse.Client.Components.DashboardContent.Menu
@using MaClasse.Client.Components.DashboardContent.Calendar
@using Microsoft.AspNetCore.Authorization
@using MaClasse.Client.Components.DashboardContent.Files
@using MaClasse.Client.Components.DashboardContent.Lesson
@using MaClasse.Client.Components.Utils

@attribute [Authorize]

<PageTitle>Tableau de bord</PageTitle>

<a class="dashboard-skip-link" href="#dashboard-main">Aller au contenu principal</a>

<div class="dashboard-page">
    <div class="dashboard-shell">
        <header class="dashboard-topbar">
            <TopMenu/>
        </header>

        <main id="dashboard-main" class="dashboard-content" tabindex="-1">
            <aside class="dashboard-left-panel" aria-label="Panneau ressources">
                <section class="dashboard-card dashboard-reading-card"
                         aria-label="@(_hasCurrentCourse ? "Cours en cours" : "Prochain cours")"
                         style="@GetNextCourseCardStyle()">
                    <h3>
                        <MudIcon Icon="@Icons.Material.Filled.AutoStories" Class="dashboard-title-icon" aria-hidden="true" />
                        @(_hasCurrentCourse ? "Cours en cours" : "Prochain cours")
                    </h3>
                    <p aria-live="polite">@_nextCoursePreview</p>

                    @if (_nextCourseAppointment is not null)
                    {
                        <h4 class="dashboard-course-title">@(_nextCourseAppointment.Text ?? "Cours sans titre")</h4>
                        <p class="dashboard-course-time">
                            @_nextCourseAppointment.Start.ToLocalTime().ToString("HH:mm")
                            -
                            @_nextCourseAppointment.End.ToLocalTime().ToString("HH:mm")
                        </p>

                        <MudButton Variant="MudBlazor.Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="@OpenNextCourseInLessonPanel">
                            Afficher le cours
                        </MudButton>
                    }
                </section>

                <section class="dashboard-card dashboard-stats-card" aria-label="Indicateurs rapides">
                    <article>
                        <span>Leçons cette semaine</span>
                        <strong>@_weeklyLessonCount</strong>
                    </article>
                    <article>
                        <span>Heures cette semaine</span>
                        <strong>@_weeklyHoursLabel</strong>
                    </article>
                </section>

                <section class="dashboard-card dashboard-files-card" aria-label="Documents">
                    <FileExplorer/>
                </section>
            </aside>

            <section class="dashboard-center-panel" aria-label="Panneau cours">
                <section class="dashboard-card dashboard-center-main-card">
                    <LessonView/>
                </section>
            </section>

            <aside class="dashboard-right-panel" aria-label="Panneau agenda">
                <section class="dashboard-card dashboard-scheduler-card">
                    <Scheduler/>
                </section>

                <section class="dashboard-card dashboard-tools-card" aria-label="Outils de classe">
                    <h3>
                        <MudIcon Icon="@Icons.Material.Filled.Timer" Class="dashboard-title-icon" aria-hidden="true" />
                        Outils de classe
                    </h3>

                    <div class="dashboard-tools-switch" role="tablist" aria-label="Sélection d'outil">
                        <MudButton Variant="@(_activeTool == DashboardTool.Timer ? MudBlazor.Variant.Filled : MudBlazor.Variant.Outlined)"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   role="tab"
                                   aria-selected="@(_activeTool == DashboardTool.Timer)"
                                   OnClick="@(() => SelectTool(DashboardTool.Timer))">
                            Minuteur
                        </MudButton>
                        <MudButton Variant="@(_activeTool == DashboardTool.Stopwatch ? MudBlazor.Variant.Filled : MudBlazor.Variant.Outlined)"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   role="tab"
                                   aria-selected="@(_activeTool == DashboardTool.Stopwatch)"
                                   OnClick="@(() => SelectTool(DashboardTool.Stopwatch))">
                            Chronomètre
                        </MudButton>
                    </div>

                    @if (_activeTool == DashboardTool.Timer)
                    {
                        <div class="dashboard-tool-panel" role="tabpanel" aria-label="Panneau minuteur">
                            <div class="dashboard-tool-time" aria-live="polite">@GetTimerDisplay()</div>
                            <div class="dashboard-tool-chip-row">
                                <MudChip T="string" Color="Color.Primary" Variant="MudBlazor.Variant.Outlined" OnClick="@(() => AddMinutesToTimer(1))">+1 min</MudChip>
                                <MudChip T="string" Color="Color.Primary" Variant="MudBlazor.Variant.Outlined" OnClick="@(() => AddMinutesToTimer(5))">+5 min</MudChip>
                                <MudChip T="string" Color="Color.Primary" Variant="MudBlazor.Variant.Outlined" OnClick="@(() => AddMinutesToTimer(10))">+10 min</MudChip>
                            </div>
                            <div class="dashboard-tool-actions">
                                <MudButton Variant="MudBlazor.Variant.Filled"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           Disabled="@(_timerRemaining <= TimeSpan.Zero || _isTimerRunning)"
                                           OnClick="@StartTimer">
                                    Démarrer
                                </MudButton>
                                <MudButton Variant="MudBlazor.Variant.Outlined"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Disabled="@(!_isTimerRunning)"
                                           OnClick="@StopTimer">
                                    Arrêter
                                </MudButton>
                                <MudButton Variant="MudBlazor.Variant.Text"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@ResetTimer">
                                    Reset
                                </MudButton>
                            </div>
                        </div>
                    }
                    else if (_activeTool == DashboardTool.Stopwatch)
                    {
                        <div class="dashboard-tool-panel" role="tabpanel" aria-label="Panneau chronomètre">
                            <div class="dashboard-tool-time" aria-live="polite">@GetStopwatchDisplay()</div>
                            <div class="dashboard-tool-actions">
                                <MudButton Variant="MudBlazor.Variant.Filled"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           Disabled="@_isStopwatchRunning"
                                           OnClick="@StartStopwatch">
                                    Démarrer
                                </MudButton>
                                <MudButton Variant="MudBlazor.Variant.Outlined"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Disabled="@(!_isStopwatchRunning)"
                                           OnClick="@StopStopwatch">
                                    Arrêter
                                </MudButton>
                                <MudButton Variant="MudBlazor.Variant.Text"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@ResetStopwatch">
                                    Reset
                                </MudButton>
                            </div>
                        </div>
                    }
                    }
                </section>

                <section class="dashboard-card dashboard-sound-card" aria-label="Sonomètre">
                    <h3>
                        <MudIcon Icon="@Icons.Material.Filled.GraphicEq" Class="dashboard-title-icon" aria-hidden="true" />
                        Sonomètre
                    </h3>
                    <div class="dashboard-tool-panel" role="region" aria-label="Mesure sonore">
                        <div class="dashboard-sound-head">
                            <span>Niveau sonore (dB)</span>
                            <div class="dashboard-sound-inline-actions">
                                <MudButton Variant="MudBlazor.Variant.Filled"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           Class="dashboard-sound-action-btn"
                                           Disabled="@_isSoundMeterActive"
                                           OnClick="@StartSoundMeterAsync">
                                    Activer
                                </MudButton>
                                <MudButton Variant="MudBlazor.Variant.Outlined"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Class="dashboard-sound-action-btn"
                                           Disabled="@(!_isSoundMeterActive)"
                                           OnClick="@StopSoundMeterAsync">
                                    Arrêter
                                </MudButton>
                            </div>
                            <strong aria-live="polite">@GetSoundDbLabel()</strong>
                        </div>
                        <MudProgressLinear Value="@_soundLevel"
                                           Min="0"
                                           Max="100"
                                           Class="dashboard-sound-progress"
                                           Color="@GetSoundColor()"
                                           Rounded="true"
                                           Striped="true"
                                           Size="Size.Large"
                                           aria-label="Niveau sonore en décibels (échelle normalisée)" />
                        @if (!string.IsNullOrWhiteSpace(_soundMeterError))
                        {
                            <p class="dashboard-tool-error">@_soundMeterError</p>
                        }
                    </div>
                </section>
            </aside>
        </main>
    </div>
</div>
