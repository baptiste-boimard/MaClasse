@page "/dashboard"
@using MaClasse.Client.Components.DashboardContent.Menu
@using MaClasse.Client.Components.DashboardContent.Calendar
@using Microsoft.AspNetCore.Authorization
@using MaClasse.Client.Components.DashboardContent.Files
@using MaClasse.Client.Components.DashboardContent.Lesson
@using MaClasse.Client.Components.Utils

@attribute [Authorize]

<PageTitle>Tableau de bord</PageTitle>

<a class="dashboard-skip-link" href="#dashboard-main">Aller au contenu principal</a>

<div class="dashboard-page">
    <div class="dashboard-shell">
        <header class="dashboard-topbar">
            <TopMenu/>
        </header>

        <main id="dashboard-main" class="dashboard-content" tabindex="-1">
            <aside class="dashboard-left-panel" aria-label="Panneau ressources">
                <section class="dashboard-card dashboard-reading-card"
                         tabindex="0"
                         role="button"
                         aria-expanded="@_isNextCourseCardExpanded"
                         aria-label="@GetNextCourseCardAriaLabel()"
                         @onkeydown="HandleNextCourseCardKeyDown"
                         @onkeyup="HandleNextCourseCardKeyUp"
                         @onkeypress="HandleNextCourseCardKeyPress"
                         style="@GetNextCourseCardStyle()">
                    <h3 id="dashboard-reading-card-title">
                        <MudIcon Icon="@Icons.Material.Filled.AutoStories" Class="dashboard-title-icon" aria-hidden="true" />
                        @(_hasCurrentCourse ? "Cours en cours" : "Prochain cours")
                    </h3>
                    <p tabindex="@GetNextCourseInnerTabIndex()"
                       aria-label="@GetNextCoursePreviewAriaLabel()"
                       @ref="_nextCoursePreviewRef"
                       @onkeydown="HandleNextCoursePreviewKeyDown"
                       @onkeydown:stopPropagation="true"
                       aria-live="polite">@_nextCoursePreview</p>

                    @if (_nextCourseAppointment is not null)
                    {
                        <h4 class="dashboard-course-title"
                            tabindex="@GetNextCourseInnerTabIndex()"
                            aria-label="@GetNextCourseTitleAriaLabel()"
                            @onkeydown:stopPropagation="true"
                            @ref="_nextCourseTitleRef">@(_nextCourseAppointment.Text ?? "Cours sans titre")</h4>
                        <p class="dashboard-course-time"
                           tabindex="@GetNextCourseInnerTabIndex()"
                           aria-label="@GetNextCourseTimeAriaLabel()"
                           @onkeydown:stopPropagation="true"
                           @ref="_nextCourseTimeRef">
                            @_nextCourseAppointment.Start.ToLocalTime().ToString("HH:mm")
                            -
                            @_nextCourseAppointment.End.ToLocalTime().ToString("HH:mm")
                        </p>

                        <MudButton Variant="MudBlazor.Variant.Filled"
                                   Class="dashboard-course-action-button"
                                   tabindex="@GetNextCourseInnerTabIndex()"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   @onkeydown="HandleNextCourseButtonKeyDown"
                                   OnClick="@OpenNextCourseInLessonPanel">
                            Afficher le cours
                        </MudButton>
                    }
                </section>

                <section class="dashboard-card dashboard-stats-card"
                         tabindex="0"
                         role="button"
                         aria-expanded="@_isStatsCardExpanded"
                         aria-label="@GetStatsCardAriaLabel()"
                         @onkeydown="HandleStatsCardKeyDown">
                    <article tabindex="@GetStatsInnerTabIndex()"
                             aria-label="@GetWeeklyLessonCountAriaLabel()"
                             @ref="_statsLessonsRef"
                             @onkeydown="HandleStatsLessonsKeyDown">
                        <span>Leçons cette semaine</span>
                        <strong>@_weeklyLessonCount</strong>
                    </article>
                    <article tabindex="@GetStatsInnerTabIndex()"
                             aria-label="@GetWeeklyHoursAriaLabel()"
                             @ref="_statsHoursRef"
                             @onkeydown="HandleStatsHoursKeyDown">
                        <span>Heures cette semaine</span>
                        <strong>@_weeklyHoursLabel</strong>
                    </article>
                </section>

                <section class="dashboard-card dashboard-files-card"
                         tabindex="0"
                         role="button"
                         aria-expanded="@_isFilesCardExpanded"
                         aria-label="@GetFilesCardAriaLabel()"
                         @onkeydown="HandleFilesCardKeyDown">
                    <div @onkeydown:stopPropagation="true">
                        <FileExplorer @ref="_dashboardFileExplorerRef"
                                      ShowFileList="false"
                                      ShowAdvancedSearch="true"
                                      AllowAdvancedSearchFocus="@_isFilesCardExpanded"
                                      OnAdvancedSearchNoResultFocusFallback="FocusCenterMainCardFromFilesAsync"
                                      HeaderTitle="Recherche avancée"
                                      HeaderIcon="@Icons.Material.Filled.ManageSearch" />
                    </div>
                </section>
            </aside>

            <section class="dashboard-center-panel" tabindex="0" aria-label="Panneau cours">
                <section class="dashboard-card dashboard-center-main-card" tabindex="-1" @ref="_centerMainCardRef">
                    <LessonView/>
                </section>
            </section>

            <aside class="dashboard-right-panel" aria-label="Panneau agenda">
                <section class="dashboard-card dashboard-scheduler-card">
                    <Scheduler/>
                </section>

                <ClassToolsPanel/>
            </aside>
        </main>
    </div>
</div>
