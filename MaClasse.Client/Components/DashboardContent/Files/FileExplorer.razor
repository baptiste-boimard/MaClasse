@using MaClasse.Client.Components.Utils

<div class="file-explorer @(ShowAdvancedSearch ? "file-explorer-advanced-mode" : string.Empty)">
    @if (ShowHeader)
    {
        <div class="file-explorer-header">
            <MudText Typo="Typo.h6" Class="file-explorer-title">
                <MudIcon Icon="@HeaderIcon" />
                @HeaderTitle
            </MudText>

            @if (ShowAdvancedSearch)
            {
                <div class="file-explorer-advanced-search">
                    <span class="sr-only" aria-live="polite" aria-atomic="true">@AdvancedSearchAriaStatus</span>
                    <MudTextField T="string"
                                  Class="file-explorer-advanced-search-input"
                                  @ref="_advancedSearchInputRef"
                                  tabindex="@GetAdvancedSearchTabIndex()"
                                  Disabled="@(!AllowAdvancedSearchFocus)"
                                  Placeholder="@AdvancedSearchPlaceholder"
                                  @bind-Value="AdvancedSearchQuery"
                                  @onkeydown="HandleAdvancedSearchKeyDown"
                                  Lines="2"
                                  Variant="MudBlazor.Variant.Outlined" />

                    <MudButton Variant="MudBlazor.Variant.Filled"
                               Class="file-explorer-advanced-search-button"
                               tabindex="@GetAdvancedSearchTabIndex()"
                               Color="Color.Primary"
                               StartIcon="@(_isAdvancedSearchLoading ? null : Icons.Material.Filled.Search)"
                               OnClick="OnAdvancedSearchButtonClick"
                               @onkeydown="HandleAdvancedSearchButtonKeyDown"
                               Disabled="@_isAdvancedSearchLoading"
                    
                    
                               >
                        @if (_isAdvancedSearchLoading)
                        {
                            <span>Rechercher</span>
                        }
                        else
                        {
                            <span>Rechercher</span>
                        }
                    </MudButton>

                    <MudPaper Class="file-explorer-advanced-search-results" Elevation="0">
                        @if (_isAdvancedSearchLoading)
                        {
                            <div class="file-explorer-advanced-search-loading">
                                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                            </div>
                        }
                        else if (_advancedSearchResults.Any())
                        {
                            <div class="file-explorer-advanced-search-results-list">
                                @for (var i = 0; i < _advancedSearchResults.Count; i++)
                                {
                                    var doc = _advancedSearchResults[i];
                                    <MudCard Class="file-explorer-card"
                                             id="@GetAdvancedSearchResultCardId(i)"
                                             role="button"
                                             tabindex="@GetAdvancedSearchTabIndex()"
                                             aria-label="@GetDocumentCardAriaLabel(doc)"
                                             @onclick="@((MouseEventArgs e) => OnAdvancedSearchImageClick(e, doc))"
                                             @onkeydown="@((KeyboardEventArgs e) => OnAdvancedSearchCardKeyDown(e, doc))">
                                        <div class="file-explorer-card-body">
                                            <div class="file-explorer-thumb">
                                                @if (!string.IsNullOrWhiteSpace(doc.ThumbnailUrl))
                                                {
                                                    <img src="@doc.ThumbnailUrl"
                                                         alt="@doc.Name"
                                                         class="file-explorer-thumb-image" />
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Color="Color.Secondary" />
                                                }
                                            </div>

                                            <p class="file-explorer-file-name">@doc.Name</p>
                                        </div>
                                    </MudCard>
                                }
                            </div>
                        }
                        else if (_hasAdvancedSearchCompleted &&
                                 _lastCompletedAdvancedSearchQuery == _advancedSearchQuery &&
                                 !string.IsNullOrWhiteSpace(_advancedSearchQuery))
                        {
                            <div class="file-explorer-advanced-search-empty">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Aucun document trouvé.</MudText>
                            </div>
                        }
                    </MudPaper>
                </div>
            }
        </div>
    }

    @if (showContextMenu)
    {
        <div class="file-explorer-context-backdrop"
             aria-hidden="true"
             @onmousedown="CloseDocumentMenu"
             @onkeydown="HandleMenuBackdropKeyDown"></div>
        <MudPaper id="@_contextMenuId"
                  Class="mud-elevation-8 file-explorer-context-menu"
                  Style="@($"position:fixed; top:{menuY}px; left:{menuX}px; z-index:9999; min-width: 150px; padding: 0.5rem; background: white; border-radius: 4px; box-shadow: 0px 2px 8px rgba(0,0,0,0.2);")"
                  role="menu"
                  aria-label="Actions du document"
                  tabindex="-1"
                  @onkeydown="HandleContextMenuKeyDown"
                  @onmousedown:stopPropagation>
            <div class="file-explorer-menu-list">
                <button type="button"
                        id="@_firstContextMenuItemId"
                        class="file-explorer-menu-item"
                        role="menuitem"
                        @onclick="@(async () =>
                                   {
                                       await OpenFileInNewTab();
                                       await CloseDocumentMenu();
                                   })">
                    Ouvrir
                </button>
                @if (!_menuFromAdvancedSearch)
                {
                    <button type="button"
                            class="file-explorer-menu-item"
                            role="menuitem"
                            disabled="@(isReadOnly || _isDeleting || IsBusy)"
                            @onclick="@(async () =>
                                       {
                                           await CloseDocumentMenu();
                                           await DeleteFile();
                                       })">
                        Supprimer
                    </button>
                    <button type="button"
                            class="file-explorer-menu-item"
                            role="menuitem"
                            disabled="@(isReadOnly || _isDeleting || IsBusy)"
                            @onclick="@(async () =>
                                       {
                                           await RenameFile();
                                           await CloseDocumentMenu();
                                       })">
                        Renommer
                    </button>
                }
                else
                {
                    <button type="button"
                            class="file-explorer-menu-item"
                            role="menuitem"
                            @onclick="OpenLessonFromAdvancedSearch">
                        Ouvre la leçon
                    </button>
                    <button type="button"
                            class="file-explorer-menu-item"
                            role="menuitem"
                            disabled="@IsViewingAnotherDashboard"
                            @onclick="CopyToCurrentLessonFromAdvancedSearch">
                        Copier dans la leçon
                    </button>

                    @foreach (var lessonChoice in _advancedSearchLessonChoices)
                    {
                        <button type="button"
                                class="file-explorer-menu-item"
                                role="menuitem"
                                aria-label="@GetLessonChoiceAriaLabel(lessonChoice)"
                                @onclick="@(async () => await OpenLessonChoice(lessonChoice))">
                            @GetLessonChoiceLabel(lessonChoice)
                        </button>
                    }
                }
            </div>
        </MudPaper>
    }

    @if (_isDeleting)
    {
        <div class="file-explorer-upload-modal-backdrop">
            <div class="file-explorer-upload-modal">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" Class="file-explorer-upload-spinner" />
                <MudText Typo="Typo.h6" Class="file-explorer-upload-modal-title">Suppression en cours</MudText>
                <MudText Typo="Typo.body2" Class="file-explorer-upload-modal-text">
                    <strong>@_deleteFileName</strong>
                </MudText>
            </div>
        </div>
    }
    else if (IsBusy)
    {
        <div class="file-explorer-upload-modal-backdrop">
            <div class="file-explorer-upload-modal">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" Class="file-explorer-upload-spinner" />
                <MudText Typo="Typo.h6" Class="file-explorer-upload-modal-title">Chargement en cours ...</MudText>
                @if (!string.IsNullOrWhiteSpace(BusyFileName))
                {
                    <MudText Typo="Typo.body2" Class="file-explorer-upload-modal-text">
                        <strong>@BusyFileName</strong>
                    </MudText>
                }
            </div>
        </div>
    }

    @if (ShowFileList)
    {
        <MudGrid Class="file-explorer-grid">
            @if (files is not null && files.Any())
            {
                <MudItem xs="12">
                    <div class="file-explorer-list-wrapper">
                        <div class="file-explorer-list">
                            @foreach (var doc in files)
                            {
                                <MudCard Class="file-explorer-card"
                                         role="button"
                                         tabindex="0"
                                         aria-label="@GetDocumentCardAriaLabel(doc)"
                                         @onclick="@((MouseEventArgs e) => OnImageClick(e, doc.IdDocument))"
                                         @onkeydown="@((KeyboardEventArgs e) => OnFileCardKeyDown(e, doc))">
                                    <div class="file-explorer-card-body">
                                        <div class="file-explorer-thumb">
                                            <img src="@doc.ThumbnailUrl"
                                                 alt="@doc.Name"
                                                 class="file-explorer-thumb-image" />
                                        </div>

                                        <p class="file-explorer-file-name">@doc.Name</p>
                                    </div>
                                </MudCard>
                            }
                        </div>
                    </div>
                </MudItem>
            }
            else
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Style="margin-left: 1rem">Aucun document disponible.</MudText>
                </MudItem>
            }
        </MudGrid>
    }
</div>
