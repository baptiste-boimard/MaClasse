<div class="view-dashboard-switch">
    <select class="view-dashboard-select"
            aria-label="Choisir le dashboard à consulter"
            value="@_selectedUserId"
            @onchange="OnDashboardChange">
        <option value="@_userState.Id">Vous</option>
        @foreach (var dashboard in Dashboards)
        {
            <option value="@dashboard.UserId">@dashboard.UserEmail</option>
        }
    </select>
</div>
