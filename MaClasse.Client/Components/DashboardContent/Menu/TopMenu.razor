@using MaClasse.Client.Components.Utils

<div class="top-menu">
    <div class="top-menu-brand">
        <img class="top-menu-logo"
             src="Images/IconMaClasse.png" alt="Logo MaClasse"/>
    </div>

    <div class="top-menu-center">
        <nav class="top-menu-nav" aria-label="Navigation principale">
            <MudButton Variant="MudBlazor.Variant.Filled" Size="Size.Small" Color="Color.Primary">Dashboard</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Description" aria-label="Documents" />
            <MudIconButton Icon="@Icons.Material.Filled.School" aria-label="Cours" />
            <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth" aria-label="Agenda" />
        </nav>

        <div class="top-menu-dashboard-switch">
            @if (_userState.AsDirecteur.Count > 0)
            {
                <ViewDashBoard/>
            }
        </div>
    </div>

    <div class="top-menu-date-time">
        <Date/>
        <Hour/>
    </div>

    <div class="top-menu-actions">
        <button class="top-menu-avatar-button" title="Mon profil" @onclick="@OpenProfileDialog">
            <img src="@Picture"
                 class="top-menu-avatar"
                 alt="Avatar Google"
                 referrerpolicy="no-referrer" />
        </button>

        <a class="top-menu-mail-link"
           href="https://mail.google.com"
           title="Se rendre sur votre Gmail"
           target="_blank"
           rel="noopener noreferrer">
            <strong>@Email</strong>
        </a>

        <MudButton title="Se déconnecter"
                   Variant="MudBlazor.Variant.Filled"
                   Size="Size.Small"
                   Color="Color.Warning"
                   OnClick="@Logout">
            Se déconnecter
        </MudButton>
    </div>
</div>
