@using MaClasse.Client.Components.Utils

<div class="top-menu"
     id="top-menu-entry"
     tabindex="0">
    <div class="top-menu-left" role="toolbar" aria-label="Navigation tableau de bord">
        <img class="top-menu-logo"
             src="Images/IconMaClasse.png"
             alt="Logo MaClasse" />

        <div class="top-menu-dashboard-cluster" role="group" aria-label="Sélecteur de tableau de bord">
            <span class="top-menu-dashboard-label"
                  role="note"
                  aria-label="Section Tableau de bord">
                Tableau de bord
            </span>

            @if (_userState.AsDirecteur.Count > 0)
            {
                <ViewDashBoard/>
            }
        </div>
    </div>

    <div id="top-menu-date-time" 
         class="top-menu-date-time"
         role="status"
         tabindex="0"
         aria-live="polite"
         aria-atomic="true"
         aria-label="@CurrentDateTimeAriaLabel"
         title="@CurrentDateTimeAriaLabel">
        <Date/>
        <Hour/>
    </div>

    <div class="top-menu-actions">
        <button id="top-menu-avatar-button"
                class="top-menu-avatar-button"
                title="Mon profil"
                aria-label="Avatar Google, vous rendre sur votre profil"
                @onclick="@OpenProfileDialog">
            <img src="@Picture"
                 class="top-menu-avatar"
                 alt=""
                 aria-hidden="true"
                 referrerpolicy="no-referrer" />
        </button>

        <a id="top-menu-mail-link"
           class="top-menu-mail-link"
           href="https://mail.google.com"
           title="Se rendre sur votre Gmail"
           target="_blank"
           rel="noopener noreferrer">
            <strong>@Email</strong>
        </a>

        <MudButton id="top-menu-button-logout"
                   title="Se déconnecter"
                   Class="top-menu-logout-button"
                   Variant="MudBlazor.Variant.Filled"
                   Size="Size.Small"
                   Color="Color.Warning"
                   OnClick="@Logout">
            Se déconnecter
        </MudButton>
    </div>
</div>
