@using MaClasse.Client.Components.Utils

<div class="top-menu">
    <div class="top-menu-left" role="toolbar" aria-label="Navigation dashboard">
        <img class="top-menu-logo"
             src="Images/IconMaClasse.png"
             alt="Logo MaClasse" />

        <div class="top-menu-dashboard-cluster" role="group" aria-label="Sélecteur de dashboard">
            <span class="top-menu-dashboard-label"
                  tabindex="0"
                  role="note"
                  aria-label="Section Dashboard">
                Dashboard
            </span>

            @if (_userState.AsDirecteur.Count > 0)
            {
                <ViewDashBoard/>
            }
        </div>
    </div>

    <div class="top-menu-date-time" role="status" aria-live="polite" aria-atomic="true">
        <Date/>
        <Hour/>
    </div>

    <div class="top-menu-actions">
        <button class="top-menu-avatar-button" title="Mon profil" @onclick="@OpenProfileDialog">
            <img src="@Picture"
                 class="top-menu-avatar"
                 alt="Avatar Google"
                 referrerpolicy="no-referrer" />
        </button>

        <a class="top-menu-mail-link"
           href="https://mail.google.com"
           title="Se rendre sur votre Gmail"
           target="_blank"
           rel="noopener noreferrer">
            <strong>@Email</strong>
        </a>

        <MudButton title="Se déconnecter"
                   Variant="MudBlazor.Variant.Filled"
                   Size="Size.Small"
                   Color="Color.Warning"
                   OnClick="@Logout">
            Se déconnecter
        </MudButton>
    </div>
</div>
