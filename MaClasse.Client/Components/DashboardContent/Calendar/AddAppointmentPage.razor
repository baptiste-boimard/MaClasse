@inherits ComponentBase

<MudText Typo="Typo.h6">
    @(IsEditMode ? "Modifier un événement" : "Ajouter un événement")
</MudText>

<MudTextField 
    Label="Titre"
    @bind-Value="model.Text"
    Style="margin-bottom: 0.5rem"/>

<MudGrid>
    <MudItem xs="6">
        <MudDatePicker 
            Label="Début (Date)" 
            @bind-Date="tempStartDate" />
    </MudItem>
    <MudItem xs="6">
        <MudTimePicker
            Label="Début (Heure)"
            @bind-Time="tempStartTime"
            MinuteSelectionStep="5"
            AnchorOrigin="Origin.BottomRight"
            TransformOrigin="Origin.TopRight" />
    </MudItem>
</MudGrid>

<MudGrid>
    <MudItem xs="6" Style="margin-top: 0.5rem" >
        <MudDatePicker 
            Label="Fin (Date)" 
            @bind-Date="tempEndDate" />
    </MudItem>
    <MudItem xs="6" Style="margin-top: 0.5rem">
        <MudTimePicker 
            Label="Fin (Heure)" 
            @bind-Time="tempEndTime"
            MinuteSelectionStep="5"
            AnchorOrigin="Origin.BottomRight"
            TransformOrigin="Origin.TopRight" />
    </MudItem>
</MudGrid>

<MudCheckBox
    @bind-Value="_recurring"
    Color="Color.Primary"
    Style="padding: 0 !important;
           margin-top: 0.5rem;">
    <span style="padding-left: 0.5rem">
        Planifier chaque semaine ?
    </span>
</MudCheckBox>

<div style="display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem;">
    <div>
        <MudText Typo="Typo.caption" Style="margin-bottom: 0.4rem;">Choisir une couleur</MudText>
        <div style="display: flex; gap: 0.5rem; align-items: center;">
            @foreach (var color in AvailableColors)
            {
                var isSelected = string.Equals(_colorValue, color, StringComparison.OrdinalIgnoreCase);
                <div role="button"
                     tabindex="0"
                     aria-label="@($"Sélectionner la couleur {color}")"
                     aria-pressed="@isSelected"
                     title="@color"
                     @onclick="@(() => SelectColor(color))"
                     @onkeydown="@(e => OnColorKeyDown(e, color))"
                     style=@($"width: 1.5rem; min-width: 1.5rem; max-width: 1.5rem; height: 1.5rem; min-height: 1.5rem; max-height: 1.5rem; display: inline-block; border-radius: 50%; border: {(isSelected ? "2px solid #1d2740" : "1px solid #d0d4dc")}; background-color: {color}; cursor: pointer; box-sizing: border-box; padding: 0; margin: 0; flex: 0 0 1.5rem;")>
                </div>
            }
        </div>
    </div>
</div>


<MudStack Row Spacing="2" Class="mt-4" Style="display: flex; justify-content: space-evenly">
    <MudButton 
        Color="Color.Primary" 
        OnClick="Submit"
        Size="Size.Small"
    >Enregistrer</MudButton>
    
    <MudButton
        Color="Color.Secondary"
        OnClick="Cancel"
        Size="Size.Small"
    >Annuler</MudButton>
    
    @if (IsEditMode)
        {
            <MudButton 
                Color="Color.Error" 
                Variant="MudBlazor.Variant.Filled"
                OnClick="Delete"
                Size="Size.Small"
            >Supprimer</MudButton>
        }
</MudStack>
