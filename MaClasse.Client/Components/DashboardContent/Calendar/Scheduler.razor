@using MaClasse.Shared.Models.Scheduler
@using MaClasse.Client.Components.Utils
@using Variant = MudBlazor.Variant

<div class="scheduler-view"
     id="scheduler-view-root">
    <div id="scheduler-toolbar" class="scheduler-toolbar">

        <div class="scheduler-toolbar-row">
            <MudButton id="scheduler-toolbar-today"
                       StartIcon="@Icons.Material.Filled.Today"
                       title="Aujourd'hui"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@GoToToday">
                Aujourd'hui
            </MudButton>

            <div class="scheduler-view-switch">
                <MudButtonGroup Color="Color.Info"
                                Variant="Variant.Outlined">
                    <MudIconButton id="scheduler-view-switch-today"
                                   Icon="@Icons.Material.Filled.Today"
                                   title="Vue jour"
                                   Color="Color.Info"
                                   OnClick="@(() => SetSchedulerViewAsync(0))"/>

                    <MudIconButton id="scheduler-view-switch-week"
                                   Icon="@Icons.Material.Filled.ViewWeek"
                                   title="Vue semaine"
                                   Color="Color.Info"
                                   OnClick="@(() => SetSchedulerViewAsync(1))"/>
                </MudButtonGroup>
            </div>
        </div>

        <div class="scheduler-toolbar-row">
            <MudIconButton id="scheduler-view-select-date"
                           Icon="@Icons.Material.Filled.DateRange"
                           title="Choisir une date"
                           Color="Color.Primary"
                           OnClick="@OpenDatePicker" />

            <MudIconButton id="scheduler-view-previous-date"
                           Icon="@Icons.Material.Filled.ArrowBackIosNew"
                           title="Période précédente"
                           Color="Color.Info"
                           OnClick="@GoToPrevious" />

            <MudText id="scheduler-view-select-period"
                     tabindex="0"
                     Typo="Typo.body1"
                     Class="@($"scheduler-date-label{(selectedViewIndex == 1 ? " scheduler-date-label--week" : string.Empty)}")">
                @DisplayedDateLabel
            </MudText>

            <MudIconButton id="scheduler-view-next-date"
                           Icon="@Icons.Material.Filled.ArrowForwardIos"
                           title="Période suivante"
                           Color="Color.Info"
                           OnClick="@GoToNext" />

            <MudIconButton id="scheduler-view-new-appointment"
                           Icon="@Icons.Material.Filled.PostAdd"
                           title="Ajouter un rendez-vous"
                           Disabled="_schedulerState.isReadOnly"
                           Color="Color.Success"
                           OnClick="() => OpenNewAppointment()" />
        </div>
    </div>

    @if (showContextMenu)
    {
        <MudPaper id="custom-context-menu"
                  Class="mud-elevation-8"
                  Style="@($"position:fixed; top:{menuY}px; left:{menuX}px; z-index:9999; min-width: 150px; padding: 0.5rem; background: white; border-radius: 4px; box-shadow: 0px 2px 8px rgba(0,0,0,0.2);")"
                  @onmousedown:stopPropagation>
            <MudList T="object">
                <MudListItem T="object" OnClick="@(() => { OpenLessonForSelectedAppointment(); CloseCustomMenu(); })">
                    <MudText>Afficher</MudText>
                </MudListItem>
                <MudListItem T="object" Disabled="@isReadOnly" OnClick="@(() => { OpenEditPanelForSelectedAppointment(); CloseCustomMenu(); })">
                    <MudText>Modifier</MudText>
                </MudListItem>
            </MudList>
        </MudPaper>
    }

    @if (datePickerOpen)
    {
        <div class="scheduler-floating-panel" id="scheduler-date-picker-panel" tabindex="-1">
            <MudIconButton Icon="@Icons.Material.Outlined.Cancel"
                           Size="Size.Medium"
                           OnClick="@CloseDatePicker"
                           Style="position:absolute; top:0.1rem; right:0.1rem; z-index:1100; color:white;" />
            
            <MudPaper Style="position:relative;">
                
                <div style="display:flex; justify-content:center; margin-top:-0.5rem;">
                    <MudDatePicker PickerMonth="_currentMonth"
                                   Label="Sélectionner une date"
                                   Date="@currentDate"
                                   PickerVariant="PickerVariant.Static"
                                   DateChanged="OnDatePicked" />
                </div>
            </MudPaper>
        </div>
    }

    @if (showAppointmentPanel)
    {
        <div class="scheduler-floating-panel" id="scheduler-appointment-panel" @onkeydown="OnSchedulerKeyDown">
            <AddAppointmentPage Model="@selectedAppointment"
                                Start="@selectedStart"
                                End="@selectedEnd"
                                OnSave="OnAppointmentSaved"
                                OnCancel="ClosePanel"
                                IsEditMode="@isEditMode"
                                OnDelete="OnAppointmentDeleted" />
        </div>
    }

    <div id="scheduler-canvas" class="scheduler-canvas" tabindex="0" role="img" aria-label="Grille du calendrier, navigation à la souris uniquement">
        <RadzenScheduler @ref="@scheduler"
                         @bind-Date="currentDate"
                         SelectedIndex="@selectedViewIndex"
                         SlotRender=@OnSlotRender
                         style="height: 100%; width: 100%;"
                         TItem="Appointment"
                         Data=@appointments
                         StartProperty="Start"
                         EndProperty="End"
                         ShowHeader="false"
                         TextProperty="Text"
                         SlotSelect=@OnSlotSelect
                         AppointmentSelect=@OnAppointmentSelect
                         AppointmentRender=@OnAppointmentRender
                         DaySelect="@OnDaySelect"
                         AppointmentMove=@OnAppointmentMove>
            <RadzenDayView StartTime="@startTime" EndTime="@endTime" TimeFormat="HH:mm" />
            <RadzenWeekView StartTime="@startTime" EndTime="@endTime" TimeFormat="HH:mm" />
        </RadzenScheduler>
    </div>
</div>
