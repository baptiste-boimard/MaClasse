@using System.Globalization
@using MaClasse.Client.Components.DashboardContent.Files
@using MaClasse.Client.Components.Utils
@using Microsoft.AspNetCore.Components.Forms

<div class="lesson-view">

    <div class="lesson-header">
        @if (appointement.Id == null)
        {
            <p class="lesson-header-title">
                Aucun événement sélectionné dans l'agenda
            </p>    
        }
        else
        {
            <div>
                @{
                    var parisTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Paris");
                    var startLocal = TimeZoneInfo.ConvertTimeFromUtc(appointement.Start, parisTimeZone);
                    var endLocal = TimeZoneInfo.ConvertTimeFromUtc(appointement.End, parisTimeZone);
                }
                <p class="lesson-header-title">
                    Cours du
                    @startLocal.ToString("dddd d MMMM", new CultureInfo("fr-FR"))
                    de
                    @appointement.Start.ToString("H\\hmm")
                    à
                    @appointement.End.ToString("H\\hmm")
                </p>
            </div>

            @if (appointement.Id != null)
            {
                <MudChip T="string"
                         Class="lesson-header-chip"
                         Style="@($"background: {appointement.Color}")">
                    @appointement.Text
                </MudChip>
            }
        }
    </div>

    <MudPaper Class="lesson-card" Elevation="0" Style="display:flex;flex-direction:column;flex:1 1 auto;min-height:0;height:100%;">
        <div class="lesson-tab-buttons"
             role="tablist"
             aria-label="Sections du cours">
            <MudButton Variant="MudBlazor.Variant.Text"
                       Class="@GetTabButtonClass(0)"
                       OnClick="() => activeLessonTabIndex = 0"
                       @onkeydown="(e) => HandleTabKeyDown(e, 0)"
                       role="tab"
                       aria-selected="@(activeLessonTabIndex == 0)"
                       aria-controls="lesson-panel-general"
                       id="lesson-tab-general">
                <MudIcon Icon="@Icons.Material.Filled.Tune"
                         Class="lesson-tab-icon"
                         aria-hidden="true" />
                Général
            </MudButton>
            <MudButton Variant="MudBlazor.Variant.Text"
                       Class="@GetTabButtonClass(1)"
                       OnClick="() => activeLessonTabIndex = 1"
                       @onkeydown="(e) => HandleTabKeyDown(e, 1)"
                       role="tab"
                       aria-selected="@(activeLessonTabIndex == 1)"
                       aria-controls="lesson-panel-pedagogie"
                       id="lesson-tab-pedagogie">
                <MudIcon Icon="@Icons.Material.Filled.School"
                         Class="lesson-tab-icon"
                         aria-hidden="true" />
                Pédagogie
            </MudButton>
            <MudButton Variant="MudBlazor.Variant.Text"
                       Class="@GetTabButtonClass(2)"
                       OnClick="() => activeLessonTabIndex = 2"
                       @onkeydown="(e) => HandleTabKeyDown(e, 2)"
                       role="tab"
                       aria-selected="@(activeLessonTabIndex == 2)"
                       aria-controls="lesson-panel-eleves"
                       id="lesson-tab-eleves">
                <MudIcon Icon="@Icons.Material.Filled.Groups"
                         Class="lesson-tab-icon"
                         aria-hidden="true" />
                Élèves
            </MudButton>
            <MudButton Variant="MudBlazor.Variant.Text"
                       Class="@GetTabButtonClass(3)"
                       OnClick="() => activeLessonTabIndex = 3"
                       @onkeydown="(e) => HandleTabKeyDown(e, 3)"
                       role="tab"
                       aria-selected="@(activeLessonTabIndex == 3)"
                       aria-controls="lesson-panel-succes"
                       id="lesson-tab-succes">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents"
                         Class="lesson-tab-icon"
                         aria-hidden="true" />
                Succès
            </MudButton>
        </div>

        @if (activeLessonTabIndex == 0)
        {
            <section class="lesson-tab-panel"
                     role="tabpanel"
                     id="lesson-panel-general"
                     aria-labelledby="lesson-tab-general">
                <div class="lesson-tab-content lesson-tab-content-general">
                    <MudTextField ShrinkLabel
                                  @bind-Value="lesson.Class"
                                  Label="Classe"
                                  Placeholder="Ex: CM2 A"
                                  Variant="MudBlazor.Variant.Outlined"
                                  ReadOnly="@isReadOnly" />

                    <MudTextField ShrinkLabel
                                  @bind-Value="lesson.Tilte"
                                  Label="Titre"
                                  Placeholder="Titre de la séance"
                                  Variant="MudBlazor.Variant.Outlined"
                                  ReadOnly="@isReadOnly" />

                    <div class="lesson-general-split">
                        <section class="lesson-general-material-panel">
                            <MudTextField ShrinkLabel
                                          @bind-Value="lesson.Material"
                                          Class="lesson-field-material"
                                          Label="Matériel"
                                          Placeholder="Liste du matériel nécessaire..."
                                          Variant="MudBlazor.Variant.Outlined"
                                          Lines="4"
                                          ReadOnly="@isReadOnly" />
                        </section>

                        <section class="lesson-general-documents-panel" aria-label="Mes documents du cours">
                            <div class="lesson-documents-header">
                                <MudText Typo="Typo.h6" Class="lesson-documents-title">
                                    <MudIcon Icon="@Icons.Material.Filled.FolderOpen" />
                                    Mes documents
                                </MudText>
                                <div class="lesson-documents-upload">
                                    <MudFileUpload T="IBrowserFile"
                                                   FilesChanged="UploadFiles"
                                                   Style="display: inline-block;"
                                                   Disabled="@(!CanUploadFiles || _isUploading)">
                                        <ActivatorContent>
                                            <MudButton Variant="MudBlazor.Variant.Filled"
                                                       Color="Color.Primary"
                                                       Disabled="@(!CanUploadFiles || _isUploading)"
                                                       StartIcon="@Icons.Material.Filled.CloudUpload">
                                                @if (_isUploading)
                                                {
                                                    <MudProgressCircular Indeterminate="true"
                                                                        Color="Color.Inherit"
                                                                        Size="Size.Small"
                                                                        Class="lesson-upload-spinner-inline" />
                                                }
                                                @(_isUploading ? "Chargement ..." : "Charger un fichier")
                                            </MudButton>
                                        </ActivatorContent>
                                    </MudFileUpload>
                                </div>
                            </div>
                            <FileExplorer ShowHeader="false"
                                          IsBusy="@_isUploading"
                                          BusyFileName="@_uploadFileName" />
                        </section>
                    </div>
                </div>
            </section>
        }

        @if (activeLessonTabIndex == 1)
        {
            <section class="lesson-tab-panel"
                     role="tabpanel"
                     id="lesson-panel-pedagogie"
                     aria-labelledby="lesson-tab-pedagogie">
                <div class="lesson-tab-content lesson-tab-content-pedagogie">
                    <MudTextField ShrinkLabel
                                  @bind-Value="lesson.Objective"
                                  Class="lesson-field-pedagogie"
                                  Label="Objectifs"
                                  Placeholder="Ex: Comprendre et utiliser la notion étudiée..."
                                  Variant="MudBlazor.Variant.Outlined"
                                  Lines="5"
                                  ReadOnly="@isReadOnly" />

                    <MudTextField ShrinkLabel
                                  @bind-Value="lesson.Process"
                                  Class="lesson-field-pedagogie"
                                  Label="Déroulement"
                                  Placeholder="Décrivez les étapes de la séance..."
                                  Variant="MudBlazor.Variant.Outlined"
                                  Lines="6"
                                  ReadOnly="@isReadOnly" />

                    <MudTextField ShrinkLabel
                                  @bind-Value="lesson.TeacherTask"
                                  Class="lesson-field-pedagogie"
                                  Label="Tâches de l'enseignant"
                                  Placeholder="Précisez les consignes et interventions prévues..."
                                  Variant="MudBlazor.Variant.Outlined"
                                  Lines="5"
                                  ReadOnly="@isReadOnly" />
                </div>
            </section>
        }

        @if (activeLessonTabIndex == 2)
        {
            <section class="lesson-tab-panel"
                     role="tabpanel"
                     id="lesson-panel-eleves"
                     aria-labelledby="lesson-tab-eleves">
                <div class="lesson-tab-content lesson-tab-content-eleves">
                    <MudTextField ShrinkLabel
                                  @bind-Value="lesson.StudentTask"
                                  Class="lesson-field-eleves"
                                  Label="Tâches des élèves"
                                  Placeholder="Ex: Répondre aux questions, réaliser l'activité..."
                                  Variant="MudBlazor.Variant.Outlined"
                                  Lines="6"
                                  ReadOnly="@isReadOnly" />

                    <MudTextField ShrinkLabel
                                  @bind-Value="lesson.Behavior"
                                  Class="lesson-field-eleves"
                                  Label="Comportement attendu"
                                  Placeholder="Ex: Écoute active, participation et respect des règles..."
                                  Variant="MudBlazor.Variant.Outlined"
                                  Lines="6"
                                  ReadOnly="@isReadOnly" />
                </div>
            </section>
        }

        @if (activeLessonTabIndex == 3)
        {
            <section class="lesson-tab-panel"
                     role="tabpanel"
                     id="lesson-panel-succes"
                     aria-labelledby="lesson-tab-succes">
                <div class="lesson-tab-content lesson-tab-content-succes">
                    <MudTextField ShrinkLabel
                                  @bind-Value="lesson.SuccessCriteria"
                                  Class="lesson-field-succes"
                                  Label="Critères de succès"
                                  Placeholder="Définissez les indicateurs de réussite de la séance..."
                                  Variant="MudBlazor.Variant.Outlined"
                                  Lines="8"
                                  ReadOnly="@isReadOnly" />

                    <MudTextField ShrinkLabel
                                  @bind-Value="lesson.Skills"
                                  Class="lesson-field-succes"
                                  Label="Compétences"
                                  Placeholder="Listez les compétences travaillées..."
                                  Variant="MudBlazor.Variant.Outlined"
                                  Lines="6"
                                  ReadOnly="@isReadOnly" />
                </div>
            </section>
        }

        <div class="lesson-actions">
            <div class="lesson-actions-left">
                <MudButton Variant="MudBlazor.Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SaveLesson"
                           Disabled="@isReadOnly"
                           StartIcon="@Icons.Material.Filled.Save">
                    Sauvegarder
                </MudButton>

                <MudButtonGroup Color="Color.Info"
                                Size="Size.Medium"
                                Variant="MudBlazor.Variant.Filled">
                    <MudButton OnClick="CopyLesson"
                               Disabled="@isReadOnly"
                               StartIcon="@Icons.Material.Filled.ContentCopy">
                        Copier
                    </MudButton>
                    <MudButton OnClick="PasteLesson"
                               Disabled="@(isPasteDisabled || isReadOnly)">
                        Coller
                    </MudButton>
                </MudButtonGroup>
            </div>

            <MudButton Variant="MudBlazor.Variant.Filled"
                       Color="Color.Error"
                       OnClick="DeleteLesson"
                       Disabled="@isReadOnly"
                       StartIcon="@Icons.Material.Filled.Delete">
                Supprimer
            </MudButton>
        </div>
    </MudPaper>
</div>
