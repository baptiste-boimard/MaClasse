<style>
    button:focus-visible {
        outline: 2px solid #1A73E8;
        outline-offset: 2px;
        border-radius: 4px;
    }
</style>

<div style="width: 42%;">
    <MudCard>
        <img src="Images/LogoMaClasse.png" alt="Logo de l'application MaClasse"/>
        <MudCardContent>
            <div style="display: flex;
                        flex-direction: column;
                        gap: 2rem;">
                <div style="display: flex;
                            justify-content: center;">
                    <MudText Typo="Typo.h5">@_currentTitle</MudText>
                </div>
                <div>
                    <div style="display: flex;
                                justify-content: center;"
                         id="google-button"></div>
                </div>
                <MudText Class="mt-3">
                    <span style="display: flex;
                                flex-direction: row;
                                justify-content: center !important;
                                gap: 1rem;">
                        <MudButton
                            OnClick="@OpenDialogTherms"
                            aria-label="Conditions d'utilisations de l'application"
                            Style="text-transform: none; color: #1976d2; text-decoration: underline">
                            Conditions d'utilisations
                        </MudButton>
                        <MudText>|</MudText>
                        <MudButton
                            OnClick="@OpenDialogPolicy"
                            aria-label="Politique de confidentialité de l'application"
                            Style="text-transform: none; color: #1976d2; text-decoration: underline">
                            Politique de confidentialité
                        </MudButton>
                        <MudText>|</MudText>
                        <MudButton
                            OnClick="@OpenDialogAccessibility"
                            aria-label="Conformité aux critères d'accessibilité de l'application"
                            Style="text-transform: none; color: #1976d2; text-decoration: underline">
                            Conformité aux critères d'accessibilité
                        </MudButton>
                    </span>
                </MudText>
            </div>
        </MudCardContent>
    </MudCard>
</div>