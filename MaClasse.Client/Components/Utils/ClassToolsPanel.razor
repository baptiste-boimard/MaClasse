@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div class="@PanelClass" @attributes="AdditionalAttributes">
    @if (ShowToolsCard)
    {
    <section class="class-tools-card"
             id="class-tools-card-entry"
             tabindex="0">
        <div class="class-tools-header">
            <h3>
                <MudIcon Icon="@Icons.Material.Filled.Timer" Class="class-tools-title-icon" />
                Outils de classe
            </h3>

            <div class="class-tools-switch">
                <MudButton id="class-tools-timer"
                           Variant="@(_activeTool == ToolMode.Timer ? MudBlazor.Variant.Filled : MudBlazor.Variant.Outlined)"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="class-tool-compact-btn"
                           OnClick="@(() => SelectTool(ToolMode.Timer))">
                    Minuteur
                </MudButton>
                <MudButton id="class-tools-stopwatch"
                           Variant="@(_activeTool == ToolMode.Stopwatch ? MudBlazor.Variant.Filled : MudBlazor.Variant.Outlined)"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="class-tool-compact-btn"
                           OnClick="@(() => SelectTool(ToolMode.Stopwatch))">
                    Chronomètre
                </MudButton>
            </div>
        </div>

        @if (_activeTool == ToolMode.Timer)
        {
            <div class="class-tool-panel class-tools-mode-panel class-tools-mode-panel-timer">
                <div id="class-tools-timer-show" class="class-tool-time class-tool-time-chrono" tabindex="0">@GetTimerDisplay()</div>
                <div class="class-tool-chip-row class-tool-chip-row-timer">
                    <MudChip id="class-tools-timer-add-1" T="string" Class="class-tool-compact-chip" Color="Color.Primary" Variant="MudBlazor.Variant.Outlined" OnClick="@(() => AddMinutesToTimer(1))">+1m</MudChip>
                    <MudChip id="class-tools-timer-add-5" T="string" Class="class-tool-compact-chip" Color="Color.Primary" Variant="MudBlazor.Variant.Outlined" OnClick="@(() => AddMinutesToTimer(5))">+5m</MudChip>
                    <MudChip id="class-tools-timer-add-30" T="string" Class="class-tool-compact-chip" Color="Color.Primary" Variant="MudBlazor.Variant.Outlined" OnClick="@(() => AddMinutesToTimer(10))">+10m</MudChip>
                </div>
                <div class="class-tool-actions">
                    <span id="class-tools-timer-action-start">
                        <MudButton Variant="MudBlazor.Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   Class="class-tool-compact-btn"
                                   Disabled="@(_timerRemaining <= TimeSpan.Zero || _isTimerRunning)"
                                   OnClick="@StartTimer">
                            Démarrer
                        </MudButton>
                    </span>
                    <span id="class-tools-timer-action-stop">
                        <MudButton Variant="MudBlazor.Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Class="class-tool-compact-btn"
                                   Disabled="@(!_isTimerRunning)"
                                   OnClick="@StopTimer">
                            Arrêter
                        </MudButton>
                    </span>
                    <MudButton id="class-tools-timer-action-reset"
                               Variant="MudBlazor.Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Class="class-tool-compact-btn"
                               OnClick="@ResetTimer">
                        Reset
                    </MudButton>
                </div>
            </div>
        }
        else if (_activeTool == ToolMode.Stopwatch)
        {
            <div class="class-tool-panel class-tools-mode-panel">
                <div id="class-tools-stopwatch-show" class="class-tool-time class-tool-time-chrono">@GetStopwatchDisplay()</div>
                <div class="class-tool-actions">
                    <span id="class-tools-stopwatch-start">
                        <MudButton Variant="MudBlazor.Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   Class="class-tool-compact-btn"
                                   Disabled="@_isStopwatchRunning"
                                   OnClick="@StartStopwatch">
                            Démarrer
                        </MudButton>
                    </span>
                    <span id="class-tools-stopwatch-stop">
                        <MudButton Variant="MudBlazor.Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Class="class-tool-compact-btn"
                                   Disabled="@(!_isStopwatchRunning)"
                                   OnClick="@StopStopwatch">
                            Arrêter
                        </MudButton>
                    </span>
                    <MudButton id="class-tools-stopwatch-reset"
                               Variant="MudBlazor.Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Class="class-tool-compact-btn"
                               OnClick="@ResetStopwatch">
                        Reset
                    </MudButton>
                </div>
            </div>
        }
    </section>
    }

    @if (ShowSoundCard)
    {
    <section class="class-sound-card"
             id="class-sound-card-entry"
             tabindex="0">
        <h3>
            <MudIcon Icon="@Icons.Material.Filled.GraphicEq" Class="class-tools-title-icon" />
            Sonomètre
        </h3>
        <div class="class-tool-panel">
            <div class="class-sound-head">
                <span>Niveau sonore (dB)</span>
                <div class="class-sound-inline-actions">
                    <MudButton Variant="MudBlazor.Variant.Filled"
                               Color="Color.Success"
                               Size="Size.Small"
                               Class="class-sound-action-btn"
                               Disabled="@_isSoundMeterActive"
                               OnClick="@StartSoundMeterAsync">
                        Activer
                    </MudButton>
                    <MudButton Variant="MudBlazor.Variant.Outlined"
                               Color="Color.Error"
                               Size="Size.Small"
                               Class="class-sound-action-btn"
                               Disabled="@(!_isSoundMeterActive)"
                               OnClick="@StopSoundMeterAsync">
                        Arrêter
                    </MudButton>
                </div>
                <strong>@GetSoundDbLabel()</strong>
            </div>
            <MudProgressLinear Value="@_soundLevel"
                               Min="0"
                               Max="100"
                               Class="class-sound-progress"
                               Color="@GetSoundColor()"
                               Rounded="true"
                               Striped="true"
                               Size="Size.Large" />
            @if (!string.IsNullOrWhiteSpace(_soundMeterError))
            {
                <p class="class-tool-error">@_soundMeterError</p>
            }
        </div>
    </section>
    }
</div>
