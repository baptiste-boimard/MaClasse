@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div class="@PanelClass" @attributes="AdditionalAttributes">
    @if (ShowToolsCard)
    {
    <section class="class-tools-card"
             id="class-tools-card-entry"
             tabindex="0"
             aria-label="Outils de classe">
        <div class="class-tools-header">
            <h3>
                <MudIcon Icon="@Icons.Material.Filled.Timer" Class="class-tools-title-icon" aria-hidden="true" />
                Outils de classe
            </h3>

            <div class="class-tools-switch" role="tablist" aria-label="Sélection d'outil">
                <MudButton Variant="@(_activeTool == ToolMode.Timer ? MudBlazor.Variant.Filled : MudBlazor.Variant.Outlined)"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="class-tool-compact-btn"
                           role="tab"
                           aria-selected="@(_activeTool == ToolMode.Timer)"
                           OnClick="@(() => SelectTool(ToolMode.Timer))"
                           tabindex="0">
                    Minuteur
                </MudButton>
                <MudButton Variant="@(_activeTool == ToolMode.Stopwatch ? MudBlazor.Variant.Filled : MudBlazor.Variant.Outlined)"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="class-tool-compact-btn"
                           role="tab"
                           aria-selected="@(_activeTool == ToolMode.Stopwatch)"
                           OnClick="@(() => SelectTool(ToolMode.Stopwatch))"
                           tabindex="0">
                    Chronomètre
                </MudButton>
            </div>
        </div>

        @if (_activeTool == ToolMode.Timer)
        {
            <div class="class-tool-panel class-tools-mode-panel class-tools-mode-panel-timer" role="tabpanel" aria-label="Panneau minuteur">
                <div class="class-tool-time class-tool-time-chrono" aria-live="polite">@GetTimerDisplay()</div>
                <div class="class-tool-chip-row class-tool-chip-row-timer">
                    <MudChip T="string" Class="class-tool-compact-chip" Color="Color.Primary" Variant="MudBlazor.Variant.Outlined" OnClick="@(() => AddMinutesToTimer(1))">+1m</MudChip>
                    <MudChip T="string" Class="class-tool-compact-chip" Color="Color.Primary" Variant="MudBlazor.Variant.Outlined" OnClick="@(() => AddMinutesToTimer(5))">+5m</MudChip>
                    <MudChip T="string" Class="class-tool-compact-chip" Color="Color.Primary" Variant="MudBlazor.Variant.Outlined" OnClick="@(() => AddMinutesToTimer(10))">+10m</MudChip>
                </div>
                <div class="class-tool-actions">
                    <MudButton Variant="MudBlazor.Variant.Filled"
                               Color="Color.Success"
                               Size="Size.Small"
                               Class="class-tool-compact-btn"
                               Disabled="@(_timerRemaining <= TimeSpan.Zero || _isTimerRunning)"
                               OnClick="@StartTimer">
                        Démarrer
                    </MudButton>
                    <MudButton Variant="MudBlazor.Variant.Outlined"
                               Color="Color.Error"
                               Size="Size.Small"
                               Class="class-tool-compact-btn"
                               Disabled="@(!_isTimerRunning)"
                               OnClick="@StopTimer">
                        Arrêter
                    </MudButton>
                    <MudButton Variant="MudBlazor.Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Class="class-tool-compact-btn"
                               OnClick="@ResetTimer">
                        Reset
                    </MudButton>
                </div>
            </div>
        }
        else if (_activeTool == ToolMode.Stopwatch)
        {
            <div class="class-tool-panel class-tools-mode-panel" role="tabpanel" aria-label="Panneau chronomètre">
                <div class="class-tool-time class-tool-time-chrono" aria-live="polite">@GetStopwatchDisplay()</div>
                <div class="class-tool-actions">
                    <MudButton Variant="MudBlazor.Variant.Filled"
                               Color="Color.Success"
                               Size="Size.Small"
                               Class="class-tool-compact-btn"
                               Disabled="@_isStopwatchRunning"
                               OnClick="@StartStopwatch">
                        Démarrer
                    </MudButton>
                    <MudButton Variant="MudBlazor.Variant.Outlined"
                               Color="Color.Error"
                               Size="Size.Small"
                               Class="class-tool-compact-btn"
                               Disabled="@(!_isStopwatchRunning)"
                               OnClick="@StopStopwatch">
                        Arrêter
                    </MudButton>
                    <MudButton Variant="MudBlazor.Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Class="class-tool-compact-btn"
                               OnClick="@ResetStopwatch">
                        Reset
                    </MudButton>
                </div>
            </div>
        }
    </section>
    }

    @if (ShowSoundCard)
    {
    <section class="class-sound-card"
             id="class-sound-card-entry"
             tabindex="0"
             aria-label="Sonomètre">
        <h3>
            <MudIcon Icon="@Icons.Material.Filled.GraphicEq" Class="class-tools-title-icon" aria-hidden="true" />
            Sonomètre
        </h3>
        <div class="class-tool-panel" role="region" aria-label="Mesure sonore">
            <div class="class-sound-head">
                <span>Niveau sonore (dB)</span>
                <div class="class-sound-inline-actions">
                    <MudButton Variant="MudBlazor.Variant.Filled"
                               Color="Color.Success"
                               Size="Size.Small"
                               Class="class-sound-action-btn"
                               Disabled="@_isSoundMeterActive"
                               OnClick="@StartSoundMeterAsync">
                        Activer
                    </MudButton>
                    <MudButton Variant="MudBlazor.Variant.Outlined"
                               Color="Color.Error"
                               Size="Size.Small"
                               Class="class-sound-action-btn"
                               Disabled="@(!_isSoundMeterActive)"
                               OnClick="@StopSoundMeterAsync">
                        Arrêter
                    </MudButton>
                </div>
                <strong aria-live="polite">@GetSoundDbLabel()</strong>
            </div>
            <MudProgressLinear Value="@_soundLevel"
                               Min="0"
                               Max="100"
                               Class="class-sound-progress"
                               Color="@GetSoundColor()"
                               Rounded="true"
                               Striped="true"
                               Size="Size.Large"
                               aria-label="Niveau sonore en décibels (échelle normalisée)" />
            @if (!string.IsNullOrWhiteSpace(_soundMeterError))
            {
                <p class="class-tool-error">@_soundMeterError</p>
            }
        </div>
    </section>
    }
</div>
