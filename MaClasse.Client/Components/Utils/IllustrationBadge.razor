<span class="ill-badge ill-@Kind" aria-hidden="true">
    @if (Kind == "orbit")
    {
        <svg viewBox="0 0 24 24" class="ill-svg">
            <circle cx="12" cy="12" r="5.2" class="ill-fill-main" />
            <ellipse cx="12" cy="12" rx="9" ry="3.2" class="ill-stroke-main" />
            <circle cx="17.5" cy="8" r="1.4" class="ill-fill-accent" />
        </svg>
    }
    else if (Kind == "book")
    {
        <svg viewBox="0 0 24 24" class="ill-svg">
            <path d="M5 6.8A2.8 2.8 0 0 1 7.8 4H19v14.2A2.8 2.8 0 0 0 16.2 21H7.8A2.8 2.8 0 0 1 5 18.2Z" class="ill-fill-main" />
            <path d="M9 8h7M9 11h7M9 14h5" class="ill-stroke-accent" />
        </svg>
    }
    else if (Kind == "folder")
    {
        <svg viewBox="0 0 24 24" class="ill-svg">
            <path d="M3.5 8.2A2.2 2.2 0 0 1 5.7 6h4.1l1.7 1.7H18a2.5 2.5 0 0 1 2.5 2.5v5.8A2 2 0 0 1 18.5 18H5.5a2 2 0 0 1-2-2z" class="ill-fill-main" />
            <path d="M6.8 12.2h10.4" class="ill-stroke-accent" />
        </svg>
    }
    else if (Kind == "calendar")
    {
        <svg viewBox="0 0 24 24" class="ill-svg">
            <rect x="4" y="5.5" width="16" height="14" rx="3" class="ill-fill-main" />
            <path d="M4 10h16M8 4v3M16 4v3" class="ill-stroke-main" />
            <circle cx="9" cy="13" r="1.1" class="ill-fill-accent" />
            <circle cx="12.5" cy="13" r="1.1" class="ill-fill-accent" />
            <circle cx="16" cy="13" r="1.1" class="ill-fill-accent" />
        </svg>
    }
    else
    {
        <svg viewBox="0 0 24 24" class="ill-svg">
            <circle cx="12" cy="12" r="8" class="ill-fill-main" />
            <path d="M12 7.2l1.6 3.2 3.5.5-2.5 2.4.6 3.4L12 15l-3.2 1.7.6-3.4-2.5-2.4 3.5-.5z" class="ill-fill-accent" />
        </svg>
    }
</span>

@code {
    [Parameter]
    public string Kind { get; set; } = "star";
}
